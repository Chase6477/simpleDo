<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">
    <fragment
        android:id="@+id/newTaskFragment"
        android:name="de.jr.simpledo.NewTaskFragment"
        android:label="@string/new_task_label"
        tools:layout="@layout/new_task_fragment" />
    <fragment
        android:id="@+id/mainFragment"
        android:name="de.jr.simpledo.MainFragment"
        android:label="main_fragment"
        tools:layout="@layout/main_fragment" >
        <action
            android:id="@+id/action_mainFragment_to_newTaskFragment"
            app:destination="@id/newTaskFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="de.jr.simpledo.SettingsFragment"
        android:label="settings_fragment"
        tools:layout="@layout/settings_fragment" />
    <activity
        android:id="@+id/mainActivity"
        android:name="de.jr.simpledo.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
</navigation>